{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true
